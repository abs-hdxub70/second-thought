{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "options_page": "options.html",
  "background": {"service_worker": "background.js"},
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*", "*://*.tmall.com/*", "*://*.jd.com/*", "*://*.pinduoduo.com/*", "*://*.yangkeduo.com/*",
        "*://*.vip.com/*", "*://*.suning.com/*", "*://*.douyin.com/*", "*://*.kuaishou.com/*", "*://*.xiaohongshu.com/*",
        "*://*.amazon.com/*", "*://*.amazon.de/*", "*://*.amazon.co.uk/*", "*://*.amazon.fr/*", "*://*.amazon.it/*",
        "*://*.amazon.es/*", "*://*.amazon.cn/*", "*://*.aliexpress.com/*", "*://*.temu.com/*", "*://*.shein.com/*",
        "*://*.zalando.de/*", "*://*.zalando.com/*", "*://*.zalando.fr/*", "*://*.ebay.com/*", "*://*.ebay.de/*",
        "*://*.otto.de/*", "*://*.asos.com/*", "*://*.etsy.com/*", "*://*.aboutyou.de/*", "*://*.mediamarkt.de/*",
        "http://127.0.0.1/demo-shop/*", "http://localhost/demo-shop/*"
      ],
      "js": ["detect.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
