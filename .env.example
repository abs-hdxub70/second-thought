# Language model (optional). Without a key the offline agent is used.
LLM_PROVIDER=deepseek          # deepseek | qwen | qwen-intl | custom
LLM_API_KEY=
# LLM_BASE_URL=                # only for custom
# LLM_MODEL=                   # only for custom
# LLM_REGION=CN                # only for custom: CN or INTL

# Plaid Sandbox (optional), free keys at dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=

# Storage
ST_STATE_DIR=.st_state
# ST_ENCRYPTION_KEY=           # python scripts/make_key.py
